@model SRM.Models.AllRequestsViewModel
@{
    ViewBag.Title = "View All Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="setup-container">
    <div class="section-header">
        <h2>View All Requests</h2>
        <div class="record-count">
            <strong id="js-record-count">@Model.RequestList.Count</strong> record(s) found
        </div>
    </div>

    <div class="search-area">
        <div style="display:flex; justify-content: space-between; align-items: flex-start;">
            <table class="filter-table">
                <tr>
                    <td><strong>Search By</strong></td>
                    <td>
                        <select id="searchBy" class="form-control">
                            <option value="RequestID">Request ID</option>
                            <option value="Summary">Summary</option>
                        </select>
                    </td>
                    <td><input type="text" id="searchText" placeholder="Enter keyword..." /></td>
                </tr>
                <tr>
                    <td><strong>Status Filter</strong></td>
                    <td>
                        <select id="statusFilter" class="form-control">
                            <option value="All">-- All Statuses --</option>
                            <option value="Q">Queued 👥</option>
                            <option value="F">Forwarded ➡️</option>
                            <option value="R">Resolved ✅</option>
                            <option value="C">Closed ✔️</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><strong>From</strong></td>
                    <td><input type="date" id="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></td>
                    <td rowspan="2" style="vertical-align:bottom;">
                        <button type="button" id="btnFilter" class="setup-btn-green">Search & Filter</button>
                    </td>
                </tr>
                <tr>
                    <td><strong>To</strong></td>
                    <td><input type="date" id="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></td>
                </tr>
            </table>

            <table class="status-card">
                <thead><tr><th colspan="3">Overall Status Summary</th></tr></thead>
                <tbody>
                    <tr><td>Queue</td><td align="center">👥</td><td>@Model.QueueCount</td></tr>
                    <tr><td>Forwarded</td><td align="center">➡️</td><td>@Model.ForwardedCount</td></tr>
                    <tr><td>Resolved</td><td align="center">✅</td><td>@Model.ResolvedCount</td></tr>
                    <tr><td>Closed</td><td align="center">✔️</td><td>@Model.ClosedCount</td></tr>
                    <tr style="font-weight:bold; background:#f9f9f9;"><td>Total</td><td></td><td>@Model.TotalCount</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <table class="crud-table smart-table manual-init request-table" style="width:100%">
        <thead>
            <tr>
                <th>Request ID</th>
                <th>Subject</th>
                <th>Request Date</th>
                <th>Forward To</th>
                <th>Site/Location</th>
                <th style="text-align:center;">Status</th>
                <th>Pending</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            // Error 3 Prevention: Destroy if exists
            if ($.fn.DataTable.isDataTable('.request-table')) {
                $('.request-table').DataTable().destroy();
            }

            var table = $('.request-table').DataTable({
                "processing": true,
                "serverSide": true,
                "pageLength": 10,
                "ordering": false,

                "ajax": {
                    "url": "@Url.Action("GetTableData", "ViewAllRequests")",
                    "type": "POST",
                    "data": function (d) {
                        d.statusFilter = $('#statusFilter').val();
                        d.fromDate = $('#fromDate').val();
                        d.toDate = $('#toDate').val();
                        d.searchBy = $('#searchBy').val();
                        d.searchText = $('#searchText').val();
                    }
                },
                "columns": [
                    {
                        "data": "RequestID",
                        "render": function (data, type, row) {
                            var priorityHtml = (row.Priority == 1)
                                ? '<div class="priority-badge">!</div>'
                                : '<div style="width: 20px;"></div>';

                            return '<div style="display: flex; align-items: center; gap: 10px; padding-left: 15px;">' +
                                   '<a href="/ViewAllRequests/Details/' + data + '" class="req-id-link">' + data + '</a>' +
                                   priorityHtml + '</div>';
                        }
                    },
                    { "data": "ReqSummary" },
                    { "data": "DisplayDate" },
                    {
                        "data": "Forward_To",
                        "render": function(data) { return data ? data : "---"; }
                    },
                    { "data": "Location" },
                    {
                        "data": "status",
                        "className": "text-center",
                        "render": function (data) {
                            var map = { 'Q': '👥', 'F': '➡️', 'R': '✅', 'C': '✔️' };
                            return '<span>' + (map[data] || '✔️') + '</span>';
                        }
                    },
                    { "data": "PendingTime" }
                ],
                "drawCallback": function(settings) {
                    $('#js-record-count').text(settings._iRecordsDisplay);
                }
            });

            $('#btnFilter').click(function() { table.draw(); });
            $('#statusFilter').change(function() { table.draw(); });
        });
    </script>

    <style>
        .priority-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #ff0000;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            font-weight: bold;
            font-size: 14px;
            flex-shrink: 0;
        }

        .req-id-link {
            color: #2e7d57;
            font-weight: bold;
            font-size: 1.05em;
            text-decoration: none;
        }

            .req-id-link:hover {
                text-decoration: underline;
            }

        .dataTables_filter, .dataTables_length {
            display: none;
        }
    </style>
}