@model SRM.Models.ViewModels.DashboardVM
@{
    var vm = Model ?? new SRM.Models.ViewModels.DashboardVM();
    ViewBag.Title = "MIS Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="setup-container">
    <div class="section-header">
        <h2>Management Information System</h2>
    </div>
    <div class="mis-controls">
        <div class="filter-group">
            <select id="misCategory" class="mis-select" onchange="updateMISData()">
                <option value="Activities">Activities Summary</option>
                <option value="Requests">Request Status</option>
                <option value="Assets">Asset Issuance</option>
                <option value="Incidents">Incident Reports</option>
            </select>
        </div>
        <button class="setup-btn-green" onclick="updateMISData()">Refresh Dashboard</button>
    </div>
    <div class="kpi-row">
        <div class="kpi-card" style="border-left: 5px solid var(--forest-dark);">
            <div id="kpiLabel1" class="kpi-label">Category Total</div>
            <div id="kpiValue1" class="kpi-value">@vm.TotalRequests</div>
        </div>
        <div class="kpi-card" style="border-left: 5px solid var(--forest-accent);">
            <div id="kpiLabel2" class="kpi-label">Primary Metric</div>
            <div id="kpiValue2" class="kpi-value" style="color: var(--forest-accent);">@vm.OpenRequests</div>
        </div>
        <div class="kpi-card" style="border-left: 5px solid #dc3545;">
            <div id="kpiLabel3" class="kpi-label">Secondary Metric</div>
            <div id="kpiValue3" class="kpi-value" style="color: #dc3545;">@vm.HighPriorityRequests</div>
        </div>
        <div class="kpi-card" style="border-left: 5px solid var(--neon-green);">
            <div class="kpi-label">Global Total</div>
            <div class="kpi-value">@vm.TotalRequests</div>
        </div>
    </div>



    <div class="dashboard-grid">
        <div class="mis-card">
            <h3 class="mis-card-title">Detailed Summary</h3>
            <table class="mis-table">
                <thead><tr><th>DESCRIPTION</th><th style="text-align: right;">COUNT</th></tr></thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>
        <div class="mis-card">
            <h3 class="mis-card-title">Trend Analysis</h3>
            <div style="height: 350px;"><canvas id="misChart"></canvas></div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let misChart;

        $(document).ready(function () { updateMISData(); });

        function updateMISData() {
            const category = $('#misCategory').val();

            $.getJSON('@Url.Action("Overall", "MIS")', { category: category }, function (res) {
                // 1. Update KPI Cards
                updateKPICards(category, res);

                // 2. Update Table
                renderTable(res.labels, res.data);

                // 3. Update Chart
                renderChart(res.labels, res.data, category);
            });
        }

        function updateKPICards(cat, data) {
            // Change labels based on category
            if(cat === "Activities") {
                $('#kpiLabel1').text("Total Activities");
                $('#kpiLabel2').text("Open Tasks");
                $('#kpiLabel3').text("Completed");
            } else if(cat === "Requests") {
                $('#kpiLabel1').text("Total Requests");
                $('#kpiLabel2').text("Pending/Open");
                $('#kpiLabel3').text("Forwarded");
            } else if(cat === "Assets") {
                $('#kpiLabel1').text("Total Assets");
                $('#kpiLabel2').text("Items Issued");
                $('#kpiLabel3').text("Unique Locations");
            } else {
                $('#kpiLabel1').text("Incidents Total");
                $('#kpiLabel2').text("Resolved");
                $('#kpiLabel3').text("Unresolved");
            }

            // Update Values
            $('#kpiValue1').text(data.kpi3);
            $('#kpiValue2').text(data.kpi1);
            $('#kpiValue3').text(data.kpi2);
        }

        function renderTable(labels, data) {
            let html = "";
            labels.forEach((l, i) => {
                html += `<tr><td>${l}</td><td style="text-align:right; font-weight:700;">${data[i]}</td></tr>`;
            });
            $('#tableBody').html(html);
        }

        function renderChart(labels, data, title) {
            const ctx = document.getElementById('misChart').getContext('2d');
            if (misChart) misChart.destroy();
            misChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{ label: title, data: data, backgroundColor: '#2e7d57', borderRadius: 8 }]
                },
                options: { maintainAspectRatio: false }
            });
        }
    </script>
}